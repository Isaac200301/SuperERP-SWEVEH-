# Plantilla de configuración LOCAL. Valores ficticios. Nunca pongas secretos reales aquí:
# en staging y producción van en el gestor de secretos de la plataforma (docs/05 §7).
APP_ENV=local
# Si el 8080 está ocupado, cambia los dos valores (Vite reenvía /api a SWEVEH_API_URL).
HTTP_ADDR=:8080
SWEVEH_API_URL=http://localhost:8080

# Rol sweveh_api (sin BYPASSRLS ni DDL). Contraseña de desarrollo del docker-compose.
DATABASE_URL=postgres://sweveh_api:sweveh_dev_only@localhost:54329/sweveh?sslmode=disable
# Rol sweveh_migrator: solo para `make migrate`.
MIGRATIONS_DATABASE_URL=postgres://sweveh_migrator:sweveh_dev_only@localhost:54329/sweveh?sslmode=disable
# Rol sweveh_worker: proceso del outbox.
WORKER_DATABASE_URL=postgres://sweveh_worker:sweveh_dev_only@localhost:54329/sweveh?sslmode=disable

# En local se genera una clave efímera si queda vacía. Fuera de local es obligatoria (PEM EC P-256).
JWT_PRIVATE_KEY_PEM=
JWT_KID=local-1
# En local tiene un valor por defecto. Fuera de local: al menos 32 caracteres aleatorios.
OTP_PEPPER=
# consola = imprime el código en la terminal del api (SOLO local). El canal real está abierto (Q-13/AQ-03).
OTP_SENDER=consola

APP_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY=false
LOG_LEVEL=info
# Carpeta del frontend compilado (opcional en local: con `npm run dev` lo sirve Vite).
WEB_DIR=

# WhatsApp (ADR-0025). meta = Cloud API oficial; local = simulador (no envía nada; prohibido en producción).
# Sin WHATSAPP_PROVIDER: meta si hay token, si no local. Los secretos reales van en el gestor de secretos.
WHATSAPP_PROVIDER=local
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# WhatsApp de prueba por WAHA (no oficial, solo demo, ADR-0027): `make waha` y vincular el número en Mi taller.
# Las claves van en .env (la API de WAHA y la firma de sus webhooks); sin WAHA_URL queda apagado.
WAHA_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_SESSION=default

# Intérprete del agente (ADR-0026). reglas = local y sin costo; openrouter = modelo de lenguaje (solo demo hasta AQ-09).
# Mide un modelo con los 30 mensajes de HU-102: make agent-eval
# La clave va en .env (ignorado por git), nunca aquí. AI_MODEL acepta varios separados por coma, en orden: si uno
# falla o está limitado, OpenRouter usa el siguiente. Para no pagar, solo modelos ":free", p. ej.
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
AI_PROVIDER=reglas
AI_API_KEY=
AI_MODEL=
AI_API_BASE=https://openrouter.ai/api/v1
AI_MONTHLY_CAP_MICRO_USD=5000000

# Administrador del ERP (HU-74, ADR-0030): celulares que ven el medidor de todos los talleres (separados por coma).
# Mensajes incluidos y pesos por dólar son provisionales hasta decidir el plan (D-04, Q-24).
PLATFORM_ADMINS=
PLAN_MENSAJES_INCLUIDOS=1000
TRM_COP_POR_USD=4000

# Pruebas de integración (superusuario del Postgres local del compose).
SWEVEH_TEST_ADMIN_URL=postgres://postgres:postgres_dev_only@localhost:54329/postgres?sslmode=disable

# Taller ficticio de la demo (make seed-demo / make reset-demo, HU-97, ADR-0031). Los celulares del dueño (Hernán),
# el mecánico (Jhon), la recepción (Yesica) y los clientes B (Andrés) y D (Sebastián) son los números verificados del
# equipo; vacíos = números de prueba que no reciben nada.
DEMO_CELULAR_DUENO=
DEMO_CELULAR_MECANICO=
DEMO_CELULAR_RECEPCION=
DEMO_CELULAR_B=
DEMO_CELULAR_D=
